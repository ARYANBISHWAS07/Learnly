# DynamoDB
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_SESSION_TOKEN=
# Optional: point at DynamoDB Local, e.g. http://localhost:8000
DYNAMODB_ENDPOINT_URL=
DYNAMODB_USERS_TABLE=users
DYNAMODB_COLLECTIONS_TABLE=collections
DYNAMODB_SCRAPE_JOBS_TABLE=scrape_jobs
DYNAMODB_CHUNK_QUESTION_TABLE=chunk_question
DYNAMODB_LEARNING_NODE_SUMMARIES_TABLE=learning_node_summaries
DYNAMODB_QUIZ_SESSIONS_TABLE=quiz_sessions

REDIS_URL=redis://localhost:6379/0
COLLECTIONS_GLOBAL=true

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq
GROQ_API_KEY=your-groq-api-key-here

# Jobs
JOB_EXPIRY_SECONDS=86400

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scraped_data
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=60
